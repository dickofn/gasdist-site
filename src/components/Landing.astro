---
// The landing page, in either language. src/pages/index.astro and
// src/pages/en/index.astro only pick the language.
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import printId from "../assets/shots/id/print-a4.png";
import printEn from "../assets/shots/en/print-a4.png";
import Shot from "./Shot.astro";

interface Props {
  lang: "id" | "en";
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = lang === "en" ? `${base}en/` : base;
const guide = `${home}panduan/mulai/tentang/`;
const other = lang === "en" ? base : `${base}en/`;

const T = {
  id: {
    title: "GasDist: stok LPG dan surat jalan",
    description: "Aplikasi desktop offline untuk distributor LPG: stok dalam kg, surat jalan dalam tabung, dicetak siap ditandatangani.",
    navGuide: "Panduan",
    otherLang: "English",
    h1: "Dari gudang sampai tanda tangan pelanggan.",
    lede: "GasDist mencatat stok LPG dalam kg, membuat surat jalan dalam tabung, dan mencetaknya siap ditandatangani. Berjalan di satu PC, tanpa internet.",
    ctaGuide: "Baca panduan",
    ctaShots: "Lihat tampilan",
    flowTitle: "Satu pengiriman, lima langkah",
    flow: [
      ["Terima stok", "Kiriman dari SPBE dicatat per tabung atau per kg."],
      ["Buat surat jalan", "Pilih pelanggan dan isi jumlah tabung. Sisa stok terlihat sebelum disimpan."],
      ["Posting", "Nomor diberikan otomatis dan stok langsung berkurang."],
      ["Cetak", "Tiga lembar berlabel sekali cetak, di A4, A5, atau kertas continuous. Cetak ulang ditandai SALINAN."],
      ["Ditandatangani", "Penerima menandatangani di kotaknya. Lembar yang kembali dicatat Terkirim, dengan scannya."],
    ],
    features: [
      {
        shot: "home",
        alt: "Beranda dengan surat jalan hari ini, lembar yang belum kembali, kartu backup, dan empat produk LPG",
        title: "Stok dalam kg, terbaca dalam tabung",
        body: "Beranda menunjukkan surat jalan hari ini, lembar bertanda tangan yang belum kembali, dan saldo tiap produk dalam kg dan setara tabung penuh. Produk di bawah batasnya diberi tanda Menipis, dan kartu stok menunjukkan setiap pergerakan dengan saldo berjalan.",
        link: "stok/ringkasan/",
      },
      {
        shot: "sj-form-negative",
        alt: "Formulir surat jalan dengan baris stok minus berwarna merah",
        title: "Surat jalan yang memeriksa stok sendiri",
        body: "Kolom Stok setelah berubah oranye saat stok menipis dan merah saat tidak cukup. Posting dikunci sampai jumlahnya benar, jadi stok di catatan tidak pernah minus diam-diam.",
        link: "surat-jalan/membuat/",
      },
      {
        shot: "print-window",
        max: 600,
        alt: "Jendela pratinjau cetak surat jalan dengan pilihan template, kertas, dan lembar",
        title: "Kertas yang siap ditandatangani",
        body: "Kop perusahaan dengan logo, tiga kotak tanda tangan, dan pernyataan penerimaan barang. Sekali cetak keluar lembar Pelanggan, Kembali ke kantor, dan Arsip; template Sederhana untuk dot-matrix, kertas continuous setengah, dan formulir karbon juga bisa. Cetak ulang bertanda SALINAN.",
        link: "cetak/mencetak/",
      },
      {
        shot: "reports-stock-summary",
        alt: "Ringkasan stok per produk: saldo awal, penerimaan, surat jalan, penyesuaian, dan saldo akhir",
        title: "Laporan yang cocok dengan kartu stok",
        body: "Ringkasan stok, register surat jalan, dan pengiriman per pelanggan, sopir, atau kendaraan untuk periode sampai satu tahun, dengan angka yang sama persis dengan kartu stok. Semuanya bisa diekspor ke Excel dan dicetak berhalaman. Owner dan Admin juga membaca jejak audit: siapa mengubah apa, dari apa menjadi apa.",
        link: "laporan/ringkasan-stok/",
      },
      {
        shot: "reports-loans",
        alt: "Laporan Tabung dipinjam untuk satu pangkalan: dikirim, kosong kembali, retur isi, hitungan, dan yang masih dipinjam",
        title: "Tahu berapa tabung ada di setiap pangkalan",
        body: "Kolom Kosong kembali di surat jalan mencatat tabung kosong yang ditukar pangkalan, dan ikut tercetak di lembar yang ditandatangani. Laporan Tabung dipinjam menjumlahkan yang dikirim, yang kembali, retur tabung isi, dan hitungan, per pelanggan dan produk.",
        link: "laporan/tabung-dipinjam/",
      },
      {
        shot: "users-list",
        alt: "Daftar pengguna dengan peran masing-masing",
        title: "Setiap orang mengerjakan bagiannya",
        body: "Lima peran: Owner, Admin, Gudang, Penjualan, dan Pemantau. Gudang menerima stok, Penjualan membuat surat jalan, Pemantau hanya melihat. Tombol yang bukan bagiannya tidak muncul.",
        link: "mulai/peran/",
      },
    ],
    more: "Selengkapnya di panduan",
    extrasTitle: "Juga ada",
    extras: [
      "Laporan surat jalan yang lembarnya belum kembali",
      "Retur tabung isi bernomor, dengan bukti retur yang dicetak",
      "Backup terenkripsi, bisa disalin ke flashdisk",
      "Versi baru dari satu file pembaruan bertanda tangan, dipasang tanpa internet",
      "Impor daftar pelanggan dari Excel, dengan pratinjau setiap baris",
      "Semua data ke satu file Excel untuk akuntan atau arsip",
      "Ekspor setiap laporan ke Excel, cetak dengan nomor halaman",
      "Format nomor surat jalan sesuai kebiasaan kantor",
      "Pintasan keyboard untuk input cepat",
      "Bahasa Indonesia dan Inggris, per pengguna",
      "Layar terkunci otomatis saat ditinggal",
    ],
    safetyTitle: "Data tetap aman di PC Anda",
    safety: [
      ["Database terenkripsi", "Isi database dikunci dengan kunci yang disimpan oleh sistem operasi. Menyalin filenya saja tidak cukup untuk membacanya."],
      ["Backup dengan kata sandi sendiri", "File backup aman dibawa di flashdisk. Tanpa kata sandi backup, isinya tidak bisa dibuka."],
      ["Riwayat yang tidak bisa diubah", "Pergerakan stok hanya bisa ditambah. Kesalahan dibetulkan dengan catatan baru, tidak dengan menghapus yang lama."],
      ["Jejak audit berantai", "Setiap catatan audit membawa sidik catatan sebelumnya, sehingga perubahan diam-diam akan ketahuan. Periksa data memeriksa seluruh rantainya dan saldo stok sekali klik."],
    ],
    specTitle: "Di balik layar",
    specIntro: "GasDist adalah proyek pribadi yang dibangun dengan standar aplikasi produksi.",
    spec: [
      ["Aplikasi", "Tauri 2: inti dalam Rust, antarmuka React"],
      ["Database", "SQLite dengan SQLCipher, terenkripsi penuh"],
      ["Aturan bisnis", "Ditulis test-first, tanpa akses file atau jaringan"],
      ["Pengujian", "885 tes otomatis, wajib lulus sebelum rilis"],
      ["Pemasang", "Windows (dengan WebView2 offline), Linux .deb dan .AppImage"],
      ["Rilis", "19 rilis, versi saat ini 0.13.0"],
    ],
    galleryTitle: "Tampilan aplikasi",
    footer: "GasDist dibuat oleh Dicko. Perusahaan, pelanggan, dan angka di tangkapan layar adalah contoh fiktif.",
  },
  en: {
    title: "GasDist: LPG stock and surat jalan",
    description: "An offline desktop app for LPG distributors: stock in kg, surat jalan (delivery notes) in tabung, printed ready to sign.",
    navGuide: "Guide",
    otherLang: "Bahasa Indonesia",
    h1: "From the warehouse to the customer's signature.",
    lede: "GasDist keeps LPG stock in kg, writes surat jalan (delivery notes) in tabung, and prints them ready to sign. It runs on one PC, with no internet.",
    ctaGuide: "Read the guide",
    ctaShots: "See the screens",
    flowTitle: "One delivery, five steps",
    flow: [
      ["Receive stock", "Deliveries from the filling plant are entered by tabung or by kg."],
      ["Create a surat jalan", "Pick the customer and enter the tabung. The remaining stock shows before you save."],
      ["Post", "The number is assigned automatically and stock goes down at once."],
      ["Print", "Three labelled sheets in one print, on A4, A5 or continuous paper. Reprints are marked SALINAN."],
      ["Signed", "The receiver signs in the box provided. The sheet that comes back is recorded as Delivered, with its scan."],
    ],
    features: [
      {
        shot: "home",
        alt: "Home with today's surat jalan, the signed sheets not back yet, the backup card and four LPG products",
        title: "Stock in kg, read in tabung",
        body: "Home shows today's surat jalan, the signed sheets not back yet, and every product's balance in kg and in full tabung. Products under their limit are marked low, and the kartu stok lists every movement with a running balance.",
        link: "stok/ringkasan/",
      },
      {
        shot: "sj-form-negative",
        alt: "Surat jalan form with a negative stock line shown in red",
        title: "A surat jalan that checks the stock itself",
        body: "The stock-after column turns amber when stock runs low and red when it runs out. Posting stays locked until the numbers are right, so the books never go negative by accident.",
        link: "surat-jalan/membuat/",
      },
      {
        shot: "print-window",
        max: 600,
        alt: "Surat jalan print preview window with the template, paper and sheets choices",
        title: "Paper that is ready to sign",
        body: "Company letterhead with logo, three signature boxes and a receipt statement. One print puts out the customer, back-to-office and archive sheets; a Simple template for dot-matrix, half continuous paper and carbon forms work too. Reprints are marked SALINAN.",
        link: "cetak/mencetak/",
      },
      {
        shot: "reports-stock-summary",
        alt: "Stock summary per product: opening, receipts, surat jalan, adjustments and closing",
        title: "Reports that agree with the kartu stok",
        body: "Stock summary, surat jalan register, and deliveries by customer, driver or vehicle for any period up to a year, with figures that match the kartu stok exactly. Each exports to Excel and prints with page numbers. The Owner and Admin also read the audit trail: who changed what, from what to what.",
        link: "laporan/ringkasan-stok/",
      },
      {
        shot: "reports-loans",
        alt: "The Tabung on loan report for one pangkalan: sent, empties back, returned full, counts and what is still on loan",
        title: "Know how many tabung each pangkalan holds",
        body: "The Empties back column on the surat jalan records the empty tabung a pangkalan swaps, and prints on the sheet it signs. The Tabung on loan report adds up what was sent, what came back, returns of filled tabung and counts, per customer and product.",
        link: "laporan/tabung-dipinjam/",
      },
      {
        shot: "users-list",
        alt: "User list with each user's role",
        title: "Everyone does their own part",
        body: "Five roles: Owner, Admin, Warehouse, Sales and Viewer. Warehouse receives stock, Sales writes surat jalan, Viewer only looks. Buttons for someone else's job do not appear.",
        link: "mulai/peran/",
      },
    ],
    more: "More in the guide",
    extrasTitle: "Also included",
    extras: [
      "A report of surat jalan whose signed sheet is not back yet",
      "Numbered returns of filled tabung, with a printed return note",
      "Encrypted backups you can copy to a USB stick",
      "New versions from one signed update file, installed without internet",
      "A customer list imported from Excel, with a preview of every row",
      "All data in one Excel file for an accountant or an archive",
      "Every report exported to Excel, printed with page numbers",
      "Surat jalan numbers in the office's own format",
      "Keyboard shortcuts for fast entry",
      "Indonesian and English, per user",
      "The screen locks itself when left alone",
    ],
    safetyTitle: "The data stays safe on your PC",
    safety: [
      ["Encrypted database", "The database is locked with a key the operating system keeps. Copying the file alone is not enough to read it."],
      ["Backups with their own password", "Backup files are safe to carry on a USB stick. Without the backup password they cannot be opened."],
      ["History that cannot be changed", "Stock movements can only be added. A mistake is corrected with a new entry, never by deleting the old one."],
      ["Chained audit trail", "Each audit entry carries a fingerprint of the one before it, so a quiet change would show. Check data checks the whole chain and the stock balances in one click."],
    ],
    specTitle: "Under the hood",
    specIntro: "GasDist is a personal project built to the standard of a production app.",
    spec: [
      ["App", "Tauri 2: a Rust core with a React interface"],
      ["Database", "SQLite with SQLCipher, fully encrypted"],
      ["Business rules", "Written test-first, with no file or network access"],
      ["Testing", "885 automated tests, all green before every release"],
      ["Installers", "Windows (with offline WebView2), Linux .deb and .AppImage"],
      ["Releases", "19 releases, currently version 0.13.0"],
    ],
    galleryTitle: "Screens",
    footer: "GasDist is built by Dicko. The company, customers and figures in the screenshots are fictional.",
  },
}[lang];

const gallery: [string, string][] = (
  {
    id: [
      ["home", "Beranda"],
      ["reports-register", "Register surat jalan"],
      ["sj-list", "Daftar surat jalan"],
      ["sj-form-filled", "Surat jalan baru"],
      ["sj-detail-posted", "Surat jalan diposting"],
      ["stock-receive-filled", "Terima stok"],
      ["stock-opname", "Stok opname"],
      ["stock-card", "Kartu stok"],
      ["customers-list", "Pelanggan"],
      ["master-products", "Produk"],
      ["settings-company", "Pengaturan"],
      ["account-login", "Masuk"],
      ["home.dark", "Mode gelap"],
    ],
    en: [
      ["home", "Home"],
      ["reports-register", "Surat jalan register"],
      ["sj-list", "Surat jalan list"],
      ["sj-form-filled", "New surat jalan"],
      ["sj-detail-posted", "Posted surat jalan"],
      ["stock-receive-filled", "Receive stock"],
      ["stock-opname", "Stok opname"],
      ["stock-card", "Kartu stok"],
      ["customers-list", "Customers"],
      ["master-products", "Products"],
      ["settings-company", "Settings"],
      ["account-login", "Sign in"],
      ["home.dark", "Dark mode"],
    ],
  } as const
)[lang].map(([a, b]) => [a, b]);
const paper = lang === "en" ? printEn : printId;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{T.title}</title>
    <meta name="description" content={T.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang="id" href={`https://dickofn.github.io${base}`} />
    <link rel="alternate" hreflang="en" href={`https://dickofn.github.io${base}en/`} />
    <meta property="og:title" content={T.title} />
    <meta property="og:description" content={T.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@112..125,600..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href={home}><Image src={logo} alt="" width={30} height={30} />GasDist</a>
      <nav>
        <a href={guide}>{T.navGuide}</a>
        <a href={other} hreflang={lang === "en" ? "id" : "en"}>{T.otherLang}</a>
        <a href="mailto:dickofn@gmail.com">dickofn@gmail.com</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <h1>{T.h1}</h1>
          <p class="lede">{T.lede}</p>
          <p class="ctas">
            <a class="btn btn-solid" href={guide}>{T.ctaGuide}</a>
            <a class="btn" href="#tampilan">{T.ctaShots}</a>
          </p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="window">
            <span class="window-dots"><i></i><i></i><i></i></span>
            <Shot name="sj-form-filled" lang={lang} alt="" marks={false} eager class="window-shot" />
          </div>
          <div class="paper">
            <Image src={paper} alt="" widths={[480, 980]} sizes="(max-width: 900px) 60vw, 34vw" loading="eager" />
          </div>
        </div>
      </section>

      <section class="flow">
        <h2>{T.flowTitle}</h2>
        <ol>
          {
            T.flow.map(([title, body]) => (
              <li>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="features">
        {
          T.features.map((f) => (
            <article class="feature">
              <div class="feature-copy">
                <h2>{f.title}</h2>
                <p>{f.body}</p>
                <a href={`${home}panduan/${f.link}`}>{T.more}</a>
              </div>
              <Shot name={f.shot} lang={lang} alt={f.alt} marks={false} max={f.max} class="feature-shot" />
            </article>
          ))
        }
        <div class="extras">
          <h2>{T.extrasTitle}</h2>
          <ul>
            {T.extras.map((e) => <li>{e}</li>)}
          </ul>
        </div>
      </section>

      <section class="safety">
        <h2>{T.safetyTitle}</h2>
        <dl>
          {
            T.safety.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="spec">
        <div class="spec-head">
          <h2>{T.specTitle}</h2>
          <p>{T.specIntro}</p>
        </div>
        <table>
          <tbody>
            {
              T.spec.map(([k, v]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td>{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="gallery" id="tampilan">
        <h2>{T.galleryTitle}</h2>
        <div class="gallery-grid">
          {gallery.map(([name, label]) => <Shot name={name} lang={lang} alt={label} caption={label} marks={false} max={9999} />)}
        </div>
      </section>
    </main>

    <footer class="foot">
      <p>{T.footer}</p>
      <p><a href={guide}>{T.navGuide}</a> <a href={other}>{T.otherLang}</a> <a href="mailto:dickofn@gmail.com">dickofn@gmail.com</a></p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Inter";
    font-display: swap;
    font-weight: 100 900;
    src: url("/gasdist-site/fonts/inter-latin-wght-normal.woff2") format("woff2");
  }

  :root {
    --ink: #0f1a33;
    --ink-soft: #46536d;
    --blue: #1d4ed8;
    --blue-deep: #142f86;
    --sheet: #ffffff;
    --desk: #e7ecf4;
    --amber: #f59e0b;
    --melon: #7cb342;
    --line: #c9d2e1;
    --pad: clamp(16px, 2.4vw, 52px);
    --display: "Archivo", "Inter", system-ui, sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ink: #e8edf7;
      --ink-soft: #a7b3c9;
      --blue: #6f95ff;
      --blue-deep: #0f1f4d;
      --sheet: #121a2e;
      --desk: #0a1122;
      --line: #27324a;
    }
  }
  :root[data-theme="dark"] {
    --ink: #e8edf7;
    --ink-soft: #a7b3c9;
    --blue: #6f95ff;
    --blue-deep: #0f1f4d;
    --sheet: #121a2e;
    --desk: #0a1122;
    --line: #27324a;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--desk);
    color: var(--ink);
    font:
      400 17px/1.6 "Inter",
      system-ui,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  a {
    color: var(--blue);
  }
  a:focus-visible,
  .btn:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-stretch: 118%;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }
  h2 {
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
  }
  p {
    margin: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 14px var(--pad);
    background: var(--sheet);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font: 800 1.2rem/1 var(--display);
    font-stretch: 118%;
  }
  .bar nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 1.4rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .bar nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .bar nav a:hover {
    color: var(--blue);
  }

  section {
    padding: clamp(48px, 7vw, 112px) var(--pad);
  }

  /* Hero: the app on the desk, the printed sheet it produces lying on top. */
  .hero {
    overflow-x: clip;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 4vw, 80px);
    align-items: center;
    background: var(--sheet);
    padding-bottom: clamp(64px, 9vw, 150px);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 1.1rem + 3.2vw, 4.4rem);
    font-stretch: 112%;
    font-weight: 900;
    max-width: 15ch;
  }
  .lede {
    margin-top: 1.4rem;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-block;
    padding: 0.8rem 1.3rem;
    border-radius: 8px;
    border: 2px solid var(--blue);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn-solid {
    background: var(--blue);
    color: #fff;
  }
  .btn:not(.btn-solid):hover {
    background: color-mix(in srgb, var(--blue) 10%, transparent);
  }
  .btn-solid:hover {
    background: var(--blue-deep);
    border-color: var(--blue-deep);
  }

  .hero-art {
    position: relative;
    padding-bottom: 18%;
  }
  .window {
    position: relative;
    border-radius: 12px;
    background: #dfe5ee;
    padding-top: 28px;
    box-shadow:
      0 2px 4px rgb(15 26 51 / 0.08),
      0 30px 60px -20px rgb(15 26 51 / 0.35);
  }
  .window-dots {
    position: absolute;
