---
// A screenshot of the app in the page's language, with numbered markers drawn
// over the elements the capture recorded (scripts/docs-shots in the app repo).
//
//   <Shot name="sj-form-filled" alt="..." />                 markers 1..n
//   <Shot name="sj-form-filled" marks={[3, 4, null]} />      relabel; null hides one
//   <Shot name="home" marks={false} />                       no markers
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import manifest from "../assets/shots/manifest.json";

type Box = { x: number; y: number; w: number; h: number };
type Entry = { width: number; height: number; marks: Box[] };

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** Labels for the recorded boxes, in order; null skips one. false hides all. */
  marks?: (number | string | null)[] | false;
  /** Overrides the page language (custom pages outside Starlight). */
  lang?: "id" | "en";
  /** Upper bound on the displayed width in CSS px; defaults to the capture's own width. */
  max?: number;
  /** Loads at once instead of when scrolled near; for images above the fold. */
  eager?: boolean;
  class?: string;
}

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*/*.png", { eager: true });

const { name, alt, caption, marks, max, eager = false, class: cls } = Astro.props;
const lang = Astro.props.lang ?? (Astro.locals.starlightRoute?.lang === "en" ? "en" : "id");
const key = `../assets/shots/${lang}/${name}.png`;
const img = images[key]?.default;
const entry = (manifest as Record<string, Record<string, Entry>>)[lang]?.[name];
if (!img || !entry) throw new Error(`Shot: no screenshot "${name}" for ${lang}`);

const labels = marks === false ? [] : (marks ?? entry.marks.map((_, i) => i + 1));
if (labels.length > entry.marks.length) throw new Error(`Shot: "${name}" has ${entry.marks.length} marks, got ${labels.length} labels`);
const pins = labels.flatMap((label, i) => {
  if (label === null) return [];
  const b = entry.marks[i];
  // Keeps a badge on an element at the image edge inside the frame.
  const left = Math.min(Math.max(b.x * 100, 1.6), 98.4);
  const top = Math.min(Math.max(b.y * 100, 2.4), 97.6);
  return [{ label, box: b, left, top }];
});
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
const width = Math.min(max ?? entry.width, entry.width);
---

<figure class:list={["shot not-content", cls]} style={`--shot-w: ${width}px`}>
  <a class="shot-frame" href={img.src} data-shot-zoom aria-label={alt} style={`--zoom-w: ${Math.round(entry.width * 1.5)}px`}>
    <Image src={img} alt={alt} loading={eager ? "eager" : "lazy"} widths={[Math.min(img.width, 720), Math.min(img.width, 1366), img.width]} sizes={`(max-width: ${width}px) 100vw, ${width}px`} />
    {
      pins.map((p) => (
        <>
          <span class="shot-ring" style={`left:${pct(p.box.x)};top:${pct(p.box.y)};width:${pct(p.box.w)};height:${pct(p.box.h)}`} aria-hidden="true" />
          <span class="shot-pin" style={`left:${p.left}%;top:${p.top}%`} aria-hidden="true">
            {p.label}
          </span>
        </>
      ))
    }
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Click a screenshot to see it larger, markers included.
  function setup() {
    let dialog = document.querySelector<HTMLDialogElement>("dialog.shot-zoom");
    if (!dialog) {
      dialog = document.createElement("dialog");
      dialog.className = "shot-zoom";
      dialog.addEventListener("click", () => dialog!.close());
      document.body.append(dialog);
    }
    for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-shot-zoom]")) {
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        const frame = a.cloneNode(true) as HTMLElement;
        frame.removeAttribute("href");
        dialog!.replaceChildren(frame);
        dialog!.showModal();
      });
    }
  }
  setup();
</script>

<style is:global>
  .shot {
    margin: 1.25rem 0 1.75rem;
    max-width: min(100%, var(--shot-w));
  }
  .shot-frame {
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--shot-border, #cbd5e1);
    box-shadow:
      0 1px 2px rgb(15 23 42 / 0.06),
      0 8px 24px -8px rgb(15 23 42 / 0.18);
    cursor: zoom-in;
    line-height: 0;
  }
  .shot-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-ring {
    position: absolute;
    border: 2px solid #f59e0b;
    border-radius: 6px;
    box-shadow: 0 0 0 3px rgb(245 158 11 / 0.22);
    pointer-events: none;
  }
  .shot-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: #f59e0b;
    color: #1c1917;
    border: 2px solid #fff;
    font: 700 0.85rem/1.4rem var(--sl-font, system-ui), sans-serif;
    text-align: center;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
    pointer-events: none;
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-gray-3, #64748b);
  }
  dialog.shot-zoom {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 96vw;
    max-height: 94vh;
    overflow: auto;
    cursor: zoom-out;
  }
  dialog.shot-zoom::backdrop {
    background: rgb(2 6 23 / 0.82);
  }
  dialog.shot-zoom .shot-frame {
    width: min(96vw, var(--zoom-w));
    cursor: zoom-out;
  }
</style>
